<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts: dark background with the lens, in light and dark mode alike. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it runs, so no light frame shows between the two. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
